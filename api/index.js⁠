export default async function handler(req, res) {
  if (req.method === 'GET') {
    res.setHeader('Content-Type', 'text/html; charset=utf-8');
    return res.status(200).send(`
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>5s AI Chat</title>
        <style>
          body { font-family: sans-serif; margin: 10px; background: #f0f0f0; font-size: 16px; }
          .box { background: white; padding: 10px; border-radius: 8px; margin-bottom: 10px; }
          textarea { width: 100%; height: 80px; font-size: 16px; box-sizing: border-box; }
          input[type="submit"] { width: 100%; padding: 12px; font-size: 16px; background: #007aff; color: white; border: none; border-radius: 6px; margin-top: 5px; }
          .reply { background: #e5f2ff; padding: 10px; border-radius: 8px; white-space: pre-wrap; word-wrap: break-word; }
        </style>
      </head>
      <body>
        <h3>iPhone 5s AI Chat</h3>
        <div class="box">
          <form method="POST" action="/api">
            <textarea name="prompt" placeholder="質問を入力..."></textarea><br>
            <input type="submit" value="送信する">
          </form>
        </div>
      </body>
      </html>
    `);
  }

  if (req.method === 'POST') {
    let body = '';
    req.on('data', chunk => { body += chunk.toString(); });
    req.on('end', async () => {
      const params = new URLSearchParams(body);
      const prompt = params.get('prompt') || '';
      const apiKey = process.env.GEMINI_API_KEY;

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }]
          })
        });
        const data = await response.json();
        const replyText = data.candidates?.[0]?.content?.parts?.[0]?.text || "エラーが発生しました";

        res.setHeader('Content-Type', 'text/html; charset=utf-8');
        res.status(200).send(`
          <!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <title>5s AI Chat</title>
            <style>
              body { font-family: sans-serif; margin: 10px; background: #f0f0f0; font-size: 16px; }
              .box { background: white; padding: 10px; border-radius: 8px; margin-bottom: 10px; }
              textarea { width: 100%; height: 80px; font-size: 16px; box-sizing: border-box; }
              input[type="submit"] { width: 100%; padding: 12px; font-size: 16px; background: #007aff; color: white; border: none; border-radius: 6px; margin-top: 5px; }
              .reply { background: #e5f2ff; padding: 10px; border-radius: 8px; white-space: pre-wrap; word-wrap: break-word; }
            </style>
          </head>
          <body>
            <h3>iPhone 5s AI Chat</h3>
            <div class="box">
              <strong>質問:</strong><br>${prompt.replace(/</g, "&lt;")}
            </div>
            <div class="reply">
              <strong>回答:</strong><br>${replyText.replace(/</g, "&lt;")}
            </div>
            <p><a href="/api">← 次の質問をする</a></p>
          </body>
          </html>
        `);
      } catch (err) {
        res.status(500).send("通信エラーが発生しました: " + err.message);
      }
    });
  }
}
